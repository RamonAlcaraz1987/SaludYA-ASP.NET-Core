<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaludYa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/Public/Index">🏥 SaludYa</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPublico">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navPublico">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Public/Index">Centros de salud</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Public/Buscar">Buscar especialidad</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Public/Vacunatorio">Vacunatorio</a>
                    </li>
                </ul>
                <a class="btn btn-outline-light btn-sm" href="/Account/Login">
                    Acceso institucional
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4 mb-5">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @RenderBody()
    </div>

    <footer class="bg-light py-3 text-center text-muted small border-top">
        SaludYa — Plataforma digital de centros de salud · Ciudad de San Luis
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
