@page
@model SaludYa.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<h2 class="mb-4">Bienvenido, @User.Identity?.Name</h2>

@if (User.IsInRole("superadmin"))
{
    <div class="row g-3">
        <div class="col-md-4">
            <a asp-page="/Centros/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>🏥</h1>
                    <h5>Centros de salud</h5>
                    <p class="text-muted small">Crear y administrar centros</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Especialistas/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>👨‍⚕️</h1>
                    <h5>Especialistas</h5>
                    <p class="text-muted small">Agregar, trasladar y desactivar</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Usuarios/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>👤</h1>
                    <h5>Usuarios</h5>
                    <p class="text-muted small">Alta de responsables</p>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/CatalogoVacunas/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>💉</h1>
                    <h5>Catálogo de vacunas</h5>
                    <p class="text-muted small">Calendario oficial y campañas</p>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/Auditoria/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>📋</h1>
                    <h5>Auditoría</h5>
                    <p class="text-muted small">Historial de cambios</p>
                </div>
            </a>
        </div>
    </div>
}

@if (User.IsInRole("responsable"))
{
    <div class="row g-3">
        <div class="col-md-4">
            <a asp-page="/Cronograma/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>🗓</h1>
                    <h5>Cronograma</h5>
                    <p class="text-muted small">Cargar horarios de especialistas</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Novedades/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>⚠</h1>
                    <h5>Novedades del día</h5>
                    <p class="text-muted small">Ausencias y cambios de horario</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Vacunas/Index" class="card text-decoration-none h-100">
                <div class="card-body text-center">
                    <h1>💉</h1>
                    <h5>Stock de vacunas</h5>
                    <p class="text-muted small">Disponibilidad del vacunatorio</p>
                </div>
            </a>
        </div>
    </div>
}
